{
  "manifest_version": 3,
  "name": "Exantrix",
  "version": "1.0.0",
  "description": "Vendez vos produits sur la marketplace Exantrix depuis n'importe quelle boutique, et faites fabriquer ce que vous voyez (impression 3D, DTF, textile).",
  "default_locale": "fr",
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Exantrix",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png"
    }
  },
  "background": {
    "service_worker": "arriere_plan.js",
    "scripts": [
      "arriere_plan.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "contenu.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://exantrix.com/*"
  ],
  "homepage_url": "https://exantrix.com/extensions/",
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@exantrix.com",
      "strict_min_version": "115.0"
    }
  }
}